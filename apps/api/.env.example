# Environment variables for the API app.
# Copy this file to .env and fill in real values. .env is never committed.

# Database (required) — PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/phenomenal_art_gallery?schema=public

# Server port the API listens on (defaults to 3000)
PORT=3000

# Allowed CORS origins, comma-separated (the web app's origin(s)).
# When unset, the request origin is reflected and credentials are still allowed.
CORS_ORIGIN=http://localhost:3000

# Public URL of the API — used to build email-verification links
APP_URL=http://localhost:3000

# Mail: SMTP connection string. When unset, mails are logged to the console
# instead of being sent (development fallback).
SMTP_URL=smtp://user:password@localhost:587

# From-address for outgoing mail
MAIL_FROM="Accounts <accounts@example.com>"

# Cloudinary (required for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
